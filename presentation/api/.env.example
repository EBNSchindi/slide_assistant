# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Test Mode (use mock agents without API key)
# Set to true to test without OpenAI API key
TEST_MODE=false

# Server Configuration
HOST=localhost
PORT=8001

# CORS Configuration
# Comma-separated list of allowed origins
# Example: http://localhost:3000,http://localhost:8000,https://myapp.com
# WARNING: Use "*" only for development, NOT for production!
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Model Configuration
DEFAULT_MODEL=gpt-4o
